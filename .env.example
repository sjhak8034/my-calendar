# Supabase 대시보드 > Project Settings > API 에서 복사한다.
NEXT_PUBLIC_SUPABASE_URL=
# publishable key (기존 anon key도 사용 가능)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI 대화(Task 009). 서버 전용 키이므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# https://aistudio.google.com/apikey (Google AI Studio)에서 발급한다.
GEMINI_API_KEY=
# 비워 두면 코드의 기본 모델(lib/ai/limits.ts)을 쓴다.
GEMINI_MODEL=

# 알림 발송 워커(Task 010). 서버 전용 키들이므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# Supabase 대시보드 > Project Settings > API 의 service_role(또는 secret) 키. RLS를 우회하니 절대 노출하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=
# /api/cron/notify 호출을 인증하는 공유 비밀(16자 이상 임의 문자열). pg_cron 스케줄(supabase/cron/schedule.sql)과 같은 값을 쓴다.
CRON_SECRET=

# 웹 푸시(Task 011). `npx web-push generate-vapid-keys`로 한 쌍을 만든다.
# 공개 키는 브라우저가 구독할 때 쓰므로 NEXT_PUBLIC_ 접두사를 붙이고, 비공개 키는 서버 전용이라 붙이지 않는다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 시 연락할 주소(mailto: 또는 https: URL). 예: mailto:you@example.com
VAPID_SUBJECT=

# CAPTCHA(Cloudflare Turnstile). 비워 두면 위젯을 띄우지 않는다(Supabase 대시보드의 CAPTCHA도 꺼 둔 개발 환경).
# 공개 사이트 키만 여기에 둔다. 비밀 키는 Supabase 대시보드(Authentication > Attack Protection)에만 입력한다.
# 순서 주의: 이 값을 넣고 배포한 뒤에 대시보드에서 CAPTCHA를 켠다. 대시보드를 먼저 켜면 키가 없는 앱의 가입·로그인·게스트·비밀번호 찾기가 모두 막힌다.
# 로컬 시험용 Cloudflare 테스트 키: 사이트 키 1x00000000000000000000AA(항상 통과), 비밀 키 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# 카카오톡 알림(Task 012). 서버 전용 키들이므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# Kakao Developers > 앱 > 플랫폼 키 > REST API 키, 그리고 같은 키의 Client Secret(기본 활성).
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 카카오 토큰을 DB에 암호화해 저장할 때 쓰는 32바이트 키(base64). `openssl rand -base64 32`로 만든다.
# 바꾸면 저장된 토큰을 복호화할 수 없어 모든 사용자가 카카오를 다시 연결해야 한다.
KAKAO_TOKEN_ENCRYPTION_KEY=
# 이 앱의 주소(경로·끝 슬래시 없이 origin만). OAuth Redirect URI(SITE_URL/auth/kakao/callback)와 메시지 링크에 쓴다.
# 예: http://localhost:3000. 카카오 콘솔에 등록한 Redirect URI와 정확히 같아야 한다.
SITE_URL=
